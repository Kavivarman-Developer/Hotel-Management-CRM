# Server Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
# Note: Production and concurrent booking transactions require a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/grand_omr_residency

# Client Application URLs for CORS
CLIENT_URL=http://localhost:5173,http://localhost:3000,https://grandomrresidency.ai.studio

# JWT Secrets (Minimum 32 characters in production)
JWT_ACCESS_SECRET=grand_omr_residency_super_secure_access_secret_2026_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=grand_omr_residency_super_secure_refresh_secret_2026_key
JWT_REFRESH_EXPIRES_IN=7d

# QR & Cryptographic Tokens
QR_TOKEN_SECRET=grand_omr_qr_token_signing_secret_2026_omr_chennai

# Payment Provider Configuration
# Supported: DEVELOPMENT_ADAPTER, RAZORPAY, STRIPE, CASH
PAYMENT_PROVIDER=DEVELOPMENT_ADAPTER
PAYMENT_WEBHOOK_SECRET=dev_webhook_signing_secret_omr
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email Provider Configuration
# Supported: CONSOLE, SMTP, RESEND
EMAIL_PROVIDER=CONSOLE
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=reservations@grandomrresidency.com

# SMS Provider Configuration
# Supported: CONSOLE, TWILIO, MSG91
SMS_PROVIDER=CONSOLE
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# Private File Storage for Guest IDs
# Supported: LOCAL, S3
PRIVATE_FILE_STORAGE=LOCAL
STORAGE_LOCAL_PATH=./uploads
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
